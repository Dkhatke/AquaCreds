# Copy to `.env` and adjust. Never commit `.env`.
# Values below are for LOCAL DEVELOPMENT only.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Postgres / PostGIS (compose service `db`)
POSTGRES_USER=aquacreds
POSTGRES_PASSWORD=aquacreds
POSTGRES_DB=aquacreds
# Used when running the API/tests on the host (outside Docker):
DATABASE_URL=postgresql+asyncpg://aquacreds:aquacreds@localhost:5432/aquacreds

# --- Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379/0

# --- Object storage (SeaweedFS in dev; Cloudflare R2 in prod)
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=auto
S3_BUCKET=aquacreds-dev
S3_ACCESS_KEY_ID=aquadev
S3_SECRET_ACCESS_KEY=aquadev-secret

# --- Auth (production requires >= 32 random chars: `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me
# TOTP secrets are Fernet-encrypted with this key (empty = built-in development key; production
# refuses it). Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Staff (verifier / registry_admin) must enrol TOTP before staff-only endpoints (default: production only).
# MFA_REQUIRED_FOR_STAFF=true
# Auth rate limits live in Valkey; "<n>/<second|minute|hour|day>".
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_IP=10/minute
# RATE_LIMIT_LOGIN_ACCOUNT=5/minute
# Proxies whose X-Forwarded-For is trusted for the client IP (IPs/CIDRs, comma-separated).
# TRUSTED_PROXY_IPS=

# --- CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# --- Public registry: web origin used in retirement-certificate links/QR codes
PUBLIC_BASE_URL=http://localhost:3000

# --- Host port overrides (optional)
# API_PORT=8000
# DB_PORT=5432
# VALKEY_PORT=6379
# S3_PORT=8333

# --- Blockchain relayer + indexer (Phase 6). Local default: Anvil (chain 31337).
# Deploy locally: anvil, then `./contracts/forge.sh script script/Deploy.s.sol --rpc-url
# http://localhost:8545 --broadcast --private-key <anvil account 0 key>` with REGISTRAR_ADDRESS /
# VERIFIER_ADDRESS / ISSUER_ADDRESS set to the derived accounts (indices below).
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
CHAIN_REGISTRY_ADDRESS=
CHAIN_CREDIT_ADDRESS=
CHAIN_MARKETPLACE_ADDRESS=
CHAIN_USDC_ADDRESS=
CHAIN_FORWARD_FUND_ADDRESS=
CHAIN_DEPLOY_BLOCK=0
# BIP-39 mnemonic for the relayer; every signer and custodial org wallet is derived from it.
# Local dev only: Anvil's public mnemonic "test test test test test test test test test test test junk".
# Production refuses an empty value and the public Anvil mnemonic; supply it as a Docker secret.
RELAYER_MNEMONIC=
# Separation of duties: registrar, verifier and issuer MUST be different derivation indices.
CHAIN_REGISTRAR_INDEX=1
CHAIN_VERIFIER_INDEX=2
CHAIN_ISSUER_INDEX=3
CHAIN_ORG_INDEX_OFFSET=1000
CHAIN_CONFIRMATIONS=3
CHAIN_GAS_LIMIT_CAP=3000000
CHAIN_GAS_PRICE_CAP_GWEI=200
CHAIN_PRIORITY_FEE_GWEI=1.5
CHAIN_INDEX_BATCH_BLOCKS=2000
CHAIN_REORG_DEPTH=12
# Polygon Amoy (later; placeholders only — never commit real values):
# CHAIN_RPC_URL=https://<provider>/<amoy-endpoint>     (Alchemy/Infura/QuickNode free tier)
# CHAIN_ID=80002
# CHAIN_CONFIRMATIONS=12
# CHAIN_PRIORITY_FEE_GWEI=30
# CHAIN_DEPLOY_BLOCK=<block of the Amoy deployment>

# --- Later phases (placeholders)
# PINATA_JWT=
# PC_SDK_SUBSCRIPTION_KEY=
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# SENTRY_DSN=
