# AquaCreds PRODUCTION environment: template for /opt/aquacreds/.env.prod on the VM.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   (then replace EVERY placeholder)
#
# `.env.prod` is git-ignored: never commit it, paste it into an issue, or copy it to CI.
# Every value below is a PLACEHOLDER. With APP_ENV=production (set by compose) the API refuses to start
# with the development JWT secret or the development S3 secret.
# Generate secrets on the VM:
#   openssl rand -hex 32     # JWT_SECRET (64 hex chars; at least 32 characters are required)
#   openssl rand -hex 24     # POSTGRES_PASSWORD, VALKEY_PASSWORD (hex = URL-safe; they go inside URLs)

# ---------------------------------------------------------------- release
# Image tag deployed from GHCR. deploy.sh overrides this on each deploy; keep it as the fallback.
# CI publishes `main` and `sha-<7-char commit>` tags for ghcr.io/dkhatke/aquacreds-{api,worker,web}. One tag covers all three.
IMAGE_TAG=main
# Optional overrides (e.g. a fork, or locally built images in a smoke test):
# API_IMAGE=ghcr.io/dkhatke/aquacreds-api
# WORKER_IMAGE=ghcr.io/dkhatke/aquacreds-worker
# WEB_IMAGE=ghcr.io/dkhatke/aquacreds-web

# ---------------------------------------------------------------- edge (Caddy)
# Public hostnames. Each needs its own DNS A record pointing at the VM's public IP (free DuckDNS
# subdomains work: one for the API, one for the web app). Do not reuse one name for both.
API_DOMAIN=api-aquacreds-example.duckdns.org
WEB_DOMAIN=aquacreds-example.duckdns.org
# Let's Encrypt account / expiry-notice address.
ACME_EMAIL=ops@example.org
# "true" exposes /openapi.json and /redoc publicly. Keep false in production.
EXPOSE_API_DOCS=false
# Host ports (keep 80/443 in production; ACME HTTP-01/TLS-ALPN-01 needs them).
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- application
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API. Set to the web app's origin: the browser
# fetches classification map tiles straight from the API origin (cross-origin from the web app).
# Must equal https://<WEB_DOMAIN> exactly (scheme + host, no trailing slash). Empty = no CORS.
CORS_ORIGINS=https://aquacreds-example.duckdns.org
# JWT signing key: >= 32 random characters. Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
# Fernet key encrypting staff TOTP secrets at rest (the API refuses to start without one). Generate:
#   docker run --rm ghcr.io/dkhatke/aquacreds-api:main python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the new key first, keep the old one after a comma until every secret is re-enrolled.
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
# Docker bridge ranges whose X-Forwarded-For is trusted for per-IP rate limits. Caddy forwards the
# client IP to the API, and the web container (BFF) forwards the browser's IP on login/API calls.
# Both live on the compose `edge` network, inside Docker's 172.16.0.0/12 default pool, so the default
# covers them. If you change Docker's default-address-pools, list the edge network's subnet here
# (docker network inspect aquacreds-prod_edge).
TRUSTED_PROXY_IPS=172.16.0.0/12

# ---------------------------------------------------------------- web app (container `web`)
# Feature flags read by the Next.js server at request time (no rebuild needed). Any non-empty value
# enables. FEATURE_DEMO needs DEMO_MODE_ENABLED=true below plus a seeded demo org (docs/DEPLOYMENT.md
# "Enabling the Explore Demo"); FEATURE_TILES shows classification tiles on the map.
FEATURE_DEMO=
FEATURE_TILES=1

# ---------------------------------------------------------------- Postgres / PostGIS (container `db`)
POSTGRES_USER=aquacreds
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
POSTGRES_DB=aquacreds

# ---------------------------------------------------------------- Valkey (Celery broker; container `valkey`)
VALKEY_PASSWORD=REPLACE_WITH_openssl_rand_hex_24

# ---------------------------------------------------------------- object storage: Cloudflare R2 (S3 API)
# R2 dashboard -> R2 -> "Manage R2 API Tokens" -> Object Read & Write, scoped to the bucket below.
# S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (the API reaches R2 here)
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Endpoint embedded in presigned upload URLs handed to browsers/phones. For R2 it is the same endpoint.
# (The bucket also needs a CORS policy allowing PUT from your web origin; see docs/DEPLOYMENT.md.)
S3_PUBLIC_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=aquacreds-prod
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# ---------------------------------------------------------------- backups (infra/scripts/backup.sh)
# Use a SEPARATE bucket and token so the app's credentials can't delete backups.
BACKUP_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=aquacreds-backups
BACKUP_S3_ACCESS_KEY_ID=REPLACE_WITH_R2_BACKUP_ACCESS_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_BACKUP_SECRET_ACCESS_KEY
BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=14
# Local copies kept on the VM in addition to R2.
BACKUP_DIR=/opt/aquacreds/backups
BACKUP_KEEP_LOCAL=3

# ---------------------------------------------------------------- monitoring (optional)
# Sentry free developer plan. Empty = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Uptime Kuma (compose profile `monitoring`), bound to 127.0.0.1 on the VM. Uncomment the profile line
# so deploy.sh keeps it running across deploys.
# COMPOSE_PROFILES=monitoring
UPTIME_KUMA_PORT=3001

# ---------------------------------------------------------------- notification email (optional)
# Off by default (in-app notifications always work). To enable, use any SMTP provider's free tier
# (e.g. Brevo 300/day, Resend 100/day): STARTTLS on 587 or SMTP_SECURITY=ssl on 465. With email
# enabled, production refuses the console backend, a missing SMTP_HOST and a @localhost sender.
# Links in emails (and the unsubscribe link to /settings/notifications) use PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://aquacreds-example.duckdns.org
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_BACKEND=smtp
NOTIFICATION_EMAIL_FROM=AquaCreds <alerts@your-verified-domain.example>
NOTIFICATION_EMAIL_RATE_PER_HOUR=10
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------- Explore Demo (SIH; off by default)
# Read-only public sessions on the synthetic seed-demo organisation (docs/DEMO.md). Production
# refuses DEMO_MODE_ENABLED=true without DEMO_ORG_ID/DEMO_ORG_SLUG, and no session is issued unless
# that organisation's name contains "(synthetic". Turn it off again after judging.
DEMO_MODE_ENABLED=false
DEMO_ORG_ID=
DEMO_ORG_SLUG=
DEMO_SESSION_TTL_MIN=60
RATE_LIMIT_DEMO_SESSION_IP=20/hour

# ---------------------------------------------------------------- later phases (placeholders, optional)
# Polygon Amoy testnet RPC (Alchemy/Infura free tier). Chain ID 80002.
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Contract addresses from `forge script script/Deploy.s.sol` (leave empty until deployed).
CHAIN_REGISTRY_ADDRESS=
CHAIN_CREDIT_ADDRESS=
CHAIN_MARKETPLACE_ADDRESS=
CHAIN_USDC_ADDRESS=
CHAIN_FORWARD_FUND_ADDRESS=
CHAIN_DEPLOY_BLOCK=0
# Relayer HD wallet (BIP-39). Required: the API refuses to start without it. Generate it offline and
# fund the registrar/verifier/issuer/funder indices with Amoy test POL (docs/DEPLOYMENT.md §3.9).
# Never reuse the Anvil dev mnemonic.
RELAYER_MNEMONIC=REPLACE_WITH_A_12_OR_24_WORD_MNEMONIC
# Gas top-ups of custodial org wallets from the funder (index 4), in wei; caps are rolling 24 h.
CHAIN_FUNDER_INDEX=4
CHAIN_ORG_WALLET_MIN_BALANCE=10000000000000000
CHAIN_ORG_WALLET_TOP_UP=20000000000000000
CHAIN_ORG_WALLET_DAILY_CAP=60000000000000000
CHAIN_FUNDER_DAILY_CAP=200000000000000000
# IPFS pinning (Pinata free tier).
PINATA_JWT=
# Microsoft Planetary Computer (optional; raises rate limits).
PC_SDK_SUBSCRIPTION_KEY=
# NASA Earthdata (GEDI).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
