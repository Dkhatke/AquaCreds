{
  "name": "@aquacreds/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AquaCreds field app (Expo): nonce-bound geotagged photo evidence and sample-plot measurements, offline-first.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "export": "expo export --platform android --output-dir dist",
    "doctor": "expo-doctor",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aquacreds/api-client": "workspace:*",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/metro-runtime": "58.0.15",
    "expo": "58.0.19",
    "expo-application": "58.1.2",
    "expo-camera": "58.0.12",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.11",
    "expo-font": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.19",
    "expo-network": "58.0.4",
    "expo-router": "58.0.26",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
