# AquaCreds production edge: automatic HTTPS (Let's Encrypt / ZeroSSL) + reverse proxy to the API.
# Environment (set by compose from .env.prod):
#   API_DOMAIN        API hostname, e.g. api.aquacreds.example.org ("localhost" => Caddy's internal CA)
#   WEB_DOMAIN        web app hostname, e.g. aquacreds.example.org (its own DNS A record; the smoke
#                     test uses web.localhost, which resolves to 127.0.0.1)
#   ACME_EMAIL        contact address for certificate expiry notices
#   EXPOSE_API_DOCS   "true" to serve /openapi.json, /docs and /redoc publicly (default: blocked)
# Validate: docker run --rm -e API_DOMAIN=api.example.org -e WEB_DOMAIN=example.org -e ACME_EMAIL=ops@example.org \
#   -v "$PWD/infra/compose/Caddyfile:/etc/caddy/Caddyfile:ro" caddy:2.10-alpine \
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
{
	email {$ACME_EMAIL}
	# Only relevant to the internal CA (localhost smoke tests); never touch the container trust store.
	skip_install_trust
	# Admin API stays on loopback inside the container (used by the healthcheck only).
	admin localhost:2019
	servers {
		# Slowloris / idle-connection protection.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# The API only returns JSON: nothing on this origin should ever load or frame anything.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		-Server
		-X-Powered-By
	}

	# API schema / interactive docs are off in production unless explicitly enabled.
	@docs {
		path /docs /docs/* /redoc /redoc/* /openapi.json
		not expression `{env.EXPOSE_API_DOCS} == "true"`
	}
	respond @docs "Not Found" 404

	# Health probes pass straight through (used by deploy.sh, Uptime Kuma, CI) without access-log noise.
	@health path /healthz /readyz
	log_skip @health

	# JSON bodies only (file uploads go straight to object storage via presigned URLs).
	request_body {
		max_size 10MB
	}

	# Map tiles (/api/v1/projects/*/classifications/*/{tiles,confidence}/{z}/{x}/{y}.png) are
	# rendered by the API with an in-process LRU and answer `Cache-Control: private, immutable`
	# plus an ETag (304 on revalidation). They are per-user (signed URLs), so no shared cache is
	# configured here on purpose; `encode` leaves image/png alone (already compressed).
	reverse_proxy api:8000 {
		header_down -Server
		# Fail fast with 502/503 instead of hanging if the API container is restarting.
		lb_try_duration 5s
		health_uri /healthz
		health_interval 15s
		health_timeout 3s
	}
}

# Web app (Next.js standalone server: site + BFF). Browsers only ever talk to this origin for
# auth/API calls (/bff/...), so session cookies stay first-party. Directly loaded by the browser:
#   - same-origin scripts/styles/fonts (next/font self-hosts) and /vendor/maplibre-gl-worker.mjs
#   - Next.js emits inline bootstrap scripts and styles, and nonces would force dynamic rendering of
#     every page, so script-src/style-src allow 'unsafe-inline' (no 'unsafe-eval').
#   - MapLibre: OpenFreeMap style/tiles/glyphs/sprites (tiles.openfreemap.org), a blob: worker
#     fallback, and classification raster tiles from the API origin (signed URLs in the TileJSON).
{$WEB_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://{$API_DOMAIN}; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org https://{$API_DOMAIN}; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Probes / static assets are not worth access-log lines.
	@static path /_next/static/* /vendor/* /imagery/*
	log_skip @static

	# BFF bodies are small JSON (uploads go straight to object storage via presigned URLs).
	request_body {
		max_size 10MB
	}

	reverse_proxy web:3000 {
		header_down -Server
		lb_try_duration 5s
		health_uri /
		health_interval 15s
		health_timeout 3s
	}
}
