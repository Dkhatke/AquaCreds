# Runs aquacreds-backup.service every night at 01:30 Asia/Kolkata (20:00 UTC).
[Unit]
Description=Nightly AquaCreds PostgreSQL backup

[Timer]
OnCalendar=*-*-* 20:00:00 UTC
RandomizedDelaySec=15min
# Catch up after the VM was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
